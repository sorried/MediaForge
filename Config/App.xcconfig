MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
SDKROOT = macosx
CLANG_ENABLE_MODULES = YES
CODE_SIGN_STYLE = Manual
CODE_SIGNING_ALLOWED = NO
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
PRODUCT_BUNDLE_IDENTIFIER = org.mediaforge.MediaForge
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.video
INFOPLIST_KEY_NSHumanReadableCopyright = Media Forge contributors
INFOPLIST_KEY_CFBundleDisplayName = Media Forge
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
SWIFT_EMIT_LOC_STRINGS = YES
INFOPLIST_KEY_CFBundleDevelopmentRegion = ru
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
